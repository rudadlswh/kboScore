//
// Info-Release.plist resolves SupabaseURL and SupabasePublishableKey from these
// build settings. Release should define production-safe defaults here and
// should not read developer-local overrides.
SUPABASE_URL = https:/$()/pbfancqzynkialupleys.supabase.co
SUPABASE_PUBLISHABLE_KEY = sb_publishable_8NIjpXX42Xq2ysXNdDHfXQ_ixXdC_da
SUPABASE_DB_SCHEMA = kbo_crawler_api
APS_ENVIRONMENT = production
KBO_APNS_ENVIRONMENT = production

// Set this to the production Spring backend origin, for example:
// KBO_PRODUCTION_BACKEND_BASE_URL = https:/$()/api.example.com
// The Release build phase rejects empty, unresolved, non-HTTPS, and localhost URLs.
KBO_PRODUCTION_BACKEND_BASE_URL = https:/$()/kboscore-back.onrender.com
KBO_BACKEND_BASE_URL = $(KBO_PRODUCTION_BACKEND_BASE_URL)
KBO_ATTENDANCE_BACKEND_BASE_URL = $(KBO_PRODUCTION_BACKEND_BASE_URL)
KBO_NOTIFICATION_REGISTRATION_URL = $(KBO_PRODUCTION_BACKEND_BASE_URL)/devices/register
KBO_LIVE_ACTIVITY_REGISTRATION_URL = $(KBO_PRODUCTION_BACKEND_BASE_URL)/devices/live-activities/register

// Fill these with App Store provisioning profile names before archiving.
KBO_APPSTORE_APP_PROVISIONING_PROFILE_SPECIFIER = KBO Score App Store 5F034
KBO_APPSTORE_EXTENSION_PROVISIONING_PROFILE_SPECIFIER = KBO Score LiveActivity App Store 5F034
