//
//  Secrets.local.xcconfig.example
//  kboScore
//
//  Copy this file to Secrets.local.xcconfig for local Debug-only overrides.
//  Do not commit the copied file.
//  This file may override the Debug defaults from Debug.xcconfig.
//  Use https:/$()/host so xcconfig preserves the double slash in URLs.
//
SUPABASE_URL = https:/$()/__SUPABASE_HOST__
SUPABASE_PUBLISHABLE_KEY = __SUPABASE_PUBLISHABLE_KEY__
