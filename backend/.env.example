POSTGRES_DB=kbo
POSTGRES_USER=admin
POSTGRES_PASSWORD=adminkbo
POSTGRES_PORT=5432

# Collector/runtime connection string. Operators must supply the real target DB
# when preparing or running the APNs sandbox smoke test.
# DATABASE_URL=postgresql://admin:adminkbo@127.0.0.1:55432/kbo

# APNs sandbox smoke-test secrets. These must be real operator-supplied values.
# Never commit the actual key material or live secret values.
# APNS_TEAM_ID=YOUR_APPLE_TEAM_ID
# APNS_KEY_ID=YOUR_APNS_KEY_ID
# APNS_BUNDLE_ID=com.your.bundle.id
# APNS_PRIVATE_KEY_PATH=/absolute/path/AuthKey_XXXXXX.p8
# APNS_USE_SANDBOX=true

# Optional test overrides. The integration test script derives sensible defaults
# from the Postgres settings above, so these usually do not need to be set.
# LOCAL_TEST_POSTGRES_PORT=55432
# TEST_DATABASE_URL=postgresql://admin:adminkbo@127.0.0.1:55432/kbo_test
# TEST_ADMIN_DATABASE_URL=postgresql://admin:adminkbo@127.0.0.1:55432/postgres
